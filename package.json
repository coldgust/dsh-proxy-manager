{
  "name": "dsh-proxy-manager",
  "version": "0.1.2",
  "type": "module",
  "description": "Manage proxy settings in DeepSeek Harness. A single settings page sets, inspects and clears the proxy configuration of the developer tools.",
  "license": "MIT",
  "author": "coldgust",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coldgust/dsh-proxy-manager.git"
  },
  "homepage": "https://github.com/coldgust/dsh-proxy-manager#readme",
  "bugs": {
    "url": "https://github.com/coldgust/dsh-proxy-manager/issues"
  },
  "exports": {
    ".": "./lib/loader.js",
    "./host": "./lib/loader.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.mjs\"",
    "check": "pnpm typecheck && pnpm build && pnpm test",
    "build:check": "node scripts/build.mjs && git diff --exit-code -- lib"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
